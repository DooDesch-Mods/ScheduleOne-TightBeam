<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TightBeam.Api - the modder-facing no-op shim for the TightBeam flashlight control API.
    A tiny, self-contained netstandard2.0 assembly with ZERO references (no MelonLoader, IL2CPP or Unity). A modder
    either references this DLL or drops the single TightBeam.cs file into their own project. It locates the running
    TightBeam host by reflection (TightBeam.Bridge.FlashlightBridge) and binds standard BCL delegates - so it shares
    NO type with the host and is a true zero-overhead no-op when TightBeam is not installed. Usage:
    TightBeam.Api.Beam.Blink(3); TightBeam.Api.Beam.BeginOverride("MyMod").SetIntensity(1f);
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TightBeam.Api</RootNamespace>
    <AssemblyName>TightBeam.Api</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
