<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared release hardening: strip Release debug info + assembly identity, cuts AV false positives (see Workspace/build/Hardening.props). -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Hardening.props')" />

  <!-- Optional Snitch profiler in Debug builds (no-op when the Snitch host is absent; the host also auto-forwards
       the panel into the Hotline overlay, so no direct Hotline dependency is needed). Exists-guarded so CI (where
       Workspace is checked out to ./Workspace, not ../Workspace) simply skips it, and Release compiles ZERO Snitch
       types. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Snitch.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Snitch.props')" />

  <!-- CI checks out the shared Workspace repo as a SUBFOLDER, so the SDK's default **/*.cs glob would sweep it in.
       No-op locally where Workspace is a sibling. -->
  <ItemGroup>
    <Compile Remove="Workspace/**/*.cs" />
    <!-- The modder shim is its own assembly and lives in this repo only so modders can get it.
         Compiling it into the host too would give the mod a second copy of the client that binds to itself. -->
    <Compile Remove="TightBeam.Api/**/*.cs" />
  </ItemGroup>

  <!-- Generates DooDesch.ModVersion.Current from this project's own version property, so MelonInfo carries the
       released version and cannot drift out of it. MUST come after the Workspace Remove so CI keeps the file. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props')" />
  <!-- Where a build is allowed to install: the test copy by default, and never a real game installation
       without saying so out loud. See Workspace/build/Deploy.props. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Deploy.props')" />


  <!--
    TightBeam - a limited-range handheld flashlight for Schedule I (MelonLoader, IL2CPP), with a public
    cross-mod control API (TightBeam.Api / the `Beam` class) so other mods can drive it: on/off, intensity, range,
    colour, plus dynamic Blink/Flicker/Pulse and scoped overrides. A tight, bounded cone instead of a map-wide
    floodlight.

    IL2CPP only (net6.0). Beyond stock UnityEngine types (Camera/Light/GameObject) it reads the game's own
    flashlight state (Phone) and has a single Harmony patch on PlayerInventory (the hotbar ALT+scroll guard).
    No S1API. In co-op it draws other players' flashlights as cones from state the game already replicates
    (Player.MimicCamera and the third-person flashlight's active flag); FishNet is a compile-time reference only,
    because Player derives from NetworkBehaviour.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>TightBeam</RootNamespace>
    <AssemblyName>TightBeam</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>
    <NoWarn>$(NoWarn);MSB3277;MSB3245</NoWarn>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>

    <WorkspaceLibPath Condition="'$(WorkspaceLibPath)' == ''">$(MSBuildThisFileDirectory)../Workspace/lib</WorkspaceLibPath>
    <GameManagedPath>$(WorkspaceLibPath)/il2cpp/game</GameManagedPath>
    <MelonLoaderPath>$(WorkspaceLibPath)/il2cpp/melonloader</MelonLoaderPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game assembly: the hotbar mouse-wheel guard, the local flashlight state, and the co-op read of other
         players (aim, flashlight on/off, vanilla lights to darken). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FishNet: compile-time only, because Player derives from NetworkBehaviour. TightBeam calls no FishNet API.
         Ships with the game, so it is not a new shipped dependency. -->
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(GameManagedPath)/Il2CppFishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks.NET (IL2CPP): the co-op beam sync writes each player's own lobby member-data key and reads the
         others'. The game uses this API nowhere, so a player without TightBeam runs no code because of us.
         Ships with the game, so it is not a new shipped dependency. -->
    <Reference Include="Il2Cppcom.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedPath)/Il2Cppcom.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameManagedPath)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(GameManagedPath)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Condition="Exists('$(ModsDirectory)')"
          Command="cmd /c if exist &quot;$(ModsDirectory)&quot; copy /Y &quot;$(TargetPath)&quot; &quot;$(ModsDirectory)&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
